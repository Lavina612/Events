{
  "uid": "events-services",
  "title": "Events Services - Overview",
  "tags": ["events", "aspnetcore", "opentelemetry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_request_duration_seconds_count, job)", "refId": "service" },
        "definition": "label_values(http_server_request_duration_seconds_count, job)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput (RPS)",
      "description": "rate(http_server_request_duration_seconds_count), excluding /metrics scrapes",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}}",
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!=\"/metrics\"}[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "histogram_quantile over http_server_request_duration_seconds_bucket",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50 {{job}}",
          "expr": "histogram_quantile(0.50, sum by (le, job) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\", http_route!=\"/metrics\"}[1m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95 {{job}}",
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\", http_route!=\"/metrics\"}[1m])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99 {{job}}",
          "expr": "histogram_quantile(0.99, sum by (le, job) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\", http_route!=\"/metrics\"}[1m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate (5xx, %)",
      "description": "Share of responses with status 5xx",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}}",
          "expr": "100 * sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$service\", http_response_status_code=~\"5..\"}[1m])) / sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$service\"}[1m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active requests",
      "description": "http_server_active_requests",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}}",
          "expr": "sum by (job) (http_server_active_requests{job=~\"$service\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": ".NET GC collections (per second)",
      "description": "rate(dotnet_gc_collections_total) by generation",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}} gen{{gc_heap_generation}}",
          "expr": "sum by (job, gc_heap_generation) (rate(dotnet_gc_collections_total{job=~\"$service\"}[1m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": ".NET thread pool threads",
      "description": "dotnet_thread_pool_thread_count_total",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}}",
          "expr": "sum by (job) (dotnet_thread_pool_thread_count_total{job=~\"$service\"})"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Process working set",
      "description": "dotnet_process_memory_working_set_bytes",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}}",
          "expr": "sum by (job) (dotnet_process_memory_working_set_bytes{job=~\"$service\"})"
        }
      ]
    }
  ]
}
